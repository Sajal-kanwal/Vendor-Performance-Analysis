# ──────────────────────────────────────────────────────────────
# Vendor Performance Analysis — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────

# MySQL Database Connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=vendor_performance

# Email Alerts (optional — used by real_time_data_pipeline.py)
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=alerts@yourcompany.com
SENDER_PASSWORD=your_app_password
RECIPIENT_EMAILS=admin@yourcompany.com,team@yourcompany.com

# Pipeline Settings
PIPELINE_BATCH_SIZE=1000
PIPELINE_LOG_LEVEL=INFO
DATA_DIR=./data
LOG_DIR=./logs
OUTPUT_DIR=./output
